<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Fake Warcraft III world for running a map's code in .NET, faster than real time, for tests and simulations.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- PrivateAssets none, so that a project that references only Moonwell.Simulation still gets Moonwell's analyzer. -->
    <ProjectReference Include="..\Moonwell\Moonwell.csproj" PrivateAssets="none" />
    <ProjectReference Include="..\Moonwell.Interactions\Moonwell.Interactions.csproj" />
    <ProjectReference Include="..\Moonwell.Physics\Moonwell.Physics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Moonwell.Testing" />
    <InternalsVisibleTo Include="Moonwell.Tests" />
  </ItemGroup>

</Project>
