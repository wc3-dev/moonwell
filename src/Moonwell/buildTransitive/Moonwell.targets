<Project>

  <!--
    build/ holds what the Moonwell build writes (the map's Main, the staged map); dotnet build must not compile it.
    This is a targets file because the Remove must come after the SDK adds Compile Include="**/*.cs", which props files precede.
  -->
  <ItemGroup>
    <Compile Remove="build/**" />
  </ItemGroup>

  <!-- But for Placed, which the build writes from the map's placed things before the compile, as the map's code names it. -->
  <ItemGroup>
    <Compile Include="build/generated/Placed.g.cs" Condition="Exists('build/generated/Placed.g.cs')" />
  </ItemGroup>

</Project>
