<Project>

  <!--
    build/ holds what the Moonwell build writes (the map's Main, the staged map); dotnet build must not compile it.
    This is a targets file because the Remove must come after the SDK adds Compile Include="**/*.cs", which props files precede.
  -->
  <ItemGroup>
    <Compile Remove="build/**" />
  </ItemGroup>

  <!-- But for Placed, the data files' classes, the looks' names and the Lua libraries' bindings, which the build writes before the compile, as the map's code names them. -->
  <ItemGroup>
    <Compile Include="build/generated/Placed.g.cs" Condition="Exists('build/generated/Placed.g.cs')" />
    <Compile Include="build/generated/Data.g.cs" Condition="Exists('build/generated/Data.g.cs')" />
    <Compile Include="build/generated/Looks.g.cs" Condition="Exists('build/generated/Looks.g.cs')" />
    <Compile Include="build/generated/LuaLibraries.g.cs" Condition="Exists('build/generated/LuaLibraries.g.cs')" />
  </ItemGroup>

  <!--
    buildtime/ holds the map's build code, which the moonwell tool compiles and runs by itself before the game code. The
    tool's own dotnet build (MoonwellGameOnly) leaves the folder out, so the game's assembly and its Lua never hold it.
    Any other build, an editor's among them, keeps it in, with the libraries it is written against, so the editor knows
    BuildStep and War3Net's types. They are not copied beside the map's assembly: only the tool runs build code.
  -->
  <ItemGroup Condition="'$(MoonwellGameOnly)' == 'true'">
    <Compile Remove="buildtime/**" />
  </ItemGroup>

  <ItemGroup Condition="'$(MoonwellGameOnly)' != 'true' And Exists('$(MSBuildProjectDirectory)/buildtime')">
    <Reference Include="$(MSBuildThisFileDirectory)../buildtime/Moonwell.BuildTime.dll;$(MSBuildThisFileDirectory)../buildtime/War3Net.*.dll" Private="false" />
  </ItemGroup>

</Project>
