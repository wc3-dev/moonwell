<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Moonwell.Build.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The deck shapes of the game's walkable destructables, measured on 3.0.1 by wc3-cs docs/tools/deck-probe; read by the physics package's bridges. -->
    <EmbeddedResource Include="Data/Decks.txt" LogicalName="Moonwell.Build.Data.Decks.txt" />
    <EmbeddedResource Include="Data/Destructables.txt" LogicalName="Moonwell.Build.Data.Destructables.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Moonwell.GameData\Moonwell.GameData.csproj" />
    <ProjectReference Include="..\Moonwell.MapFiles\Moonwell.MapFiles.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Moonwell.War3Net.Build" Version="6.1.2-moonwell.6" />
    <!-- Moonwell.War3Net.Build brings War3Net.CSharpLua (through War3Net.CodeAnalysis.Transpilers); the fork's package has the same CSharp.lua assembly, so it takes the place. -->
    <PackageReference Include="War3Net.CSharpLua" Version="2.0.4" ExcludeAssets="all" />
    <PackageReference Include="Moonwell.CSharpLua" Version="2.0.4-moonwell.24" />
    <PackageReference Include="Moonwell.CSharpLua.CoreSystem" Version="2.0.3-moonwell.13" />
    <PackageReference Include="KeraLua" Version="1.4.9" />
    <PackageReference Include="War3Net.Drawing.Blp" Version="6.0.2" />
    <PackageReference Include="StbImageSharp" Version="2.30.16" />
    <!-- Pfim's DDS reader, for the game's textures a looks table copies: Reforged stores even its Classic ones as DDS. -->
    <PackageReference Include="Pfim" Version="0.11.4" />
  </ItemGroup>

</Project>
