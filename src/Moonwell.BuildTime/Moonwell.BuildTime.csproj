<Project Sdk="Microsoft.NET.Sdk">

  <!--
    What a map's build code (the .cs files in its buildtime folder) is written against: BuildStep, the map reader, the
    cell helpers and BuildSteps, which runs a step from a test. The moonwell tool compiles and runs that code with this
    library, and the Moonwell package carries it, with War3Net's libraries beside it, so an editor knows its types
    (src/Moonwell/Moonwell.csproj packs this project's output). It is also a package of its own, for a test project of
    the map's build code, which references it and not Moonwell, so the game's analyzer stays out. It is never compiled
    to Lua.
  -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>What a Moonwell map's build code is written against: BuildStep, the map reader and the cell helpers, and BuildSteps to run a step from a test.</Description>
    <!-- War3Net's libraries beside the output, for the Moonwell package to carry. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Moonwell.Build" />
    <InternalsVisibleTo Include="Moonwell.Build.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Moonwell.War3Net.Build.Core" Version="6.1.2-moonwell.6" />
  </ItemGroup>

</Project>
