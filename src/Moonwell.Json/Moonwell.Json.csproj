<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>JSON for Moonwell maps: a tree to read and write, with System.Text.Json.Nodes' names.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- PrivateAssets none, so that a map that references only Moonwell.Json still gets Moonwell's analyzer. -->
    <ProjectReference Include="..\Moonwell\Moonwell.csproj" PrivateAssets="none" />
  </ItemGroup>

  <!--
    The package carries its C# source beside its library, like Moonwell (see Moonwell.csproj). A map without it
    carries none of its code: CSharp.lua compiles only the packages a map references.
  -->
  <ItemGroup>
    <Content Include="**/*.cs" Exclude="obj/**;bin/**" Pack="true" PackagePath="contentFiles/cs/net10.0/Moonwell.Json/" BuildAction="None" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Moonwell.Testing" />
    <InternalsVisibleTo Include="Moonwell.Tests" />
  </ItemGroup>

</Project>
