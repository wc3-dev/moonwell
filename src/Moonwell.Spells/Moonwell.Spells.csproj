<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Spell templates for Moonwell maps: a bolt, a wave, a dash, a leap, a blast, a pulsing channel, a chain and a summon, each an ability class a map inherits and sets numbers on.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- PrivateAssets none, so that a map that references only Moonwell.Spells still gets Moonwell's analyzer, Moonwell.Objects and Moonwell.Physics. -->
    <ProjectReference Include="..\Moonwell\Moonwell.csproj" PrivateAssets="none" />
    <ProjectReference Include="..\Moonwell.Objects\Moonwell.Objects.csproj" PrivateAssets="none" />
    <ProjectReference Include="..\Moonwell.Physics\Moonwell.Physics.csproj" PrivateAssets="none" />
  </ItemGroup>

  <!--
    The package carries its C# source beside its library, like Moonwell (see Moonwell.csproj). A map without it
    carries none of its code: CSharp.lua compiles only the packages a map references.
  -->
  <ItemGroup>
    <Content Include="**/*.cs" Exclude="obj/**;bin/**" Pack="true" PackagePath="contentFiles/cs/net10.0/Moonwell.Spells/" BuildAction="None" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Moonwell.Testing" />
    <InternalsVisibleTo Include="Moonwell.Tests" />
  </ItemGroup>

</Project>
