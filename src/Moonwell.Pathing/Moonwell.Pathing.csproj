<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Pathing for Moonwell maps: where a unit fits, the nearest spot it can stand, free spots for a group, and paths by the unit's size.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- PrivateAssets none, so that a map that references only Moonwell.Pathing still gets Moonwell's analyzer, and Moonwell.Objects, which the build needs to declare the helper units. -->
    <ProjectReference Include="..\Moonwell\Moonwell.csproj" PrivateAssets="none" />
    <ProjectReference Include="..\Moonwell.Objects\Moonwell.Objects.csproj" PrivateAssets="none" />
    <ProjectReference Include="..\Moonwell.Maths\Moonwell.Maths.csproj" PrivateAssets="none" />
    <ProjectReference Include="..\Moonwell.Terrain\Moonwell.Terrain.csproj" PrivateAssets="none" />
  </ItemGroup>

  <!--
    The package carries its C# source beside its library, like Moonwell (see Moonwell.csproj). A map without it
    carries none of its code: CSharp.lua compiles only the packages a map references.
  -->
  <ItemGroup>
    <Content Include="**/*.cs" Exclude="obj/**;bin/**" Pack="true" PackagePath="contentFiles/cs/net10.0/Moonwell.Pathing/" BuildAction="None" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Moonwell.Testing" />
    <InternalsVisibleTo Include="Moonwell.Tests" />
  </ItemGroup>

</Project>
