<Project>

  <!-- The fixtures reference Moonwell's projects, not its package, so they add the multiplayer analyzer the package carries. -->
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\..\src\Moonwell.Analyzers\Moonwell.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- And they compile Placed and the Lua bindings, as the package's Moonwell.targets has them do. -->
  <ItemGroup>
    <Compile Include="build/generated/Placed.g.cs" Condition="Exists('build/generated/Placed.g.cs')" />
    <Compile Include="build/generated/LuaLibraries.g.cs" Condition="Exists('build/generated/LuaLibraries.g.cs')" />
  </ItemGroup>

</Project>
