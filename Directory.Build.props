<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <Version>0.18.0</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- What every package says about itself on nuget.org; each project gives its own Description. -->
  <PropertyGroup>
    <Authors>mdlsvensson</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/wc3-dev/moonwell</PackageProjectUrl>
    <RepositoryUrl>https://github.com/wc3-dev/moonwell.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>warcraft3;wc3;map;lua</PackageTags>
  </PropertyGroup>

  <!--
    The projects under src/ that end up inside a map (the native layer, the generated standard objects, the runtime,
    the damage, maths, interactions, physics, terrain, pathing, areas, input, frames, JSON, procgen, AI and AI combat
    packages) and tests/Moonwell.Testing (the cases the map runs, on the fake world of src/Moonwell.Simulation) are
    compiled to Lua by CSharp.lua, whose Roslyn reads C# 13.
    They take no implicit usings, so every name they use is one the map's Lua must carry.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Moonwell' Or '$(MSBuildProjectName)' == 'Moonwell.Natives' Or '$(MSBuildProjectName)' == 'Moonwell.Objects' Or '$(MSBuildProjectName)' == 'Moonwell.Damage' Or '$(MSBuildProjectName)' == 'Moonwell.Maths' Or '$(MSBuildProjectName)' == 'Moonwell.Interactions' Or '$(MSBuildProjectName)' == 'Moonwell.Physics' Or '$(MSBuildProjectName)' == 'Moonwell.Terrain' Or '$(MSBuildProjectName)' == 'Moonwell.Pathing' Or '$(MSBuildProjectName)' == 'Moonwell.Areas' Or '$(MSBuildProjectName)' == 'Moonwell.Input' Or '$(MSBuildProjectName)' == 'Moonwell.Frames' Or '$(MSBuildProjectName)' == 'Moonwell.Kit' Or '$(MSBuildProjectName)' == 'Moonwell.Spells' Or '$(MSBuildProjectName)' == 'Moonwell.Json' Or '$(MSBuildProjectName)' == 'Moonwell.Procgen' Or '$(MSBuildProjectName)' == 'Moonwell.AI' Or '$(MSBuildProjectName)' == 'Moonwell.AI.Combat' Or '$(MSBuildProjectName)' == 'Moonwell.Simulation' Or '$(MSBuildProjectName)' == 'Moonwell.Testing'">
    <LangVersion>13</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <!--
    The libraries a map references ship their XML docs beside them, so an editor shows each member's summary on hover.
    A member without one is not an error: the generated natives and objects do not all have one.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Moonwell' Or '$(MSBuildProjectName)' == 'Moonwell.Natives' Or '$(MSBuildProjectName)' == 'Moonwell.Objects' Or '$(MSBuildProjectName)' == 'Moonwell.Damage' Or '$(MSBuildProjectName)' == 'Moonwell.Maths' Or '$(MSBuildProjectName)' == 'Moonwell.Interactions' Or '$(MSBuildProjectName)' == 'Moonwell.Physics' Or '$(MSBuildProjectName)' == 'Moonwell.Terrain' Or '$(MSBuildProjectName)' == 'Moonwell.Pathing' Or '$(MSBuildProjectName)' == 'Moonwell.Areas' Or '$(MSBuildProjectName)' == 'Moonwell.Input' Or '$(MSBuildProjectName)' == 'Moonwell.Frames' Or '$(MSBuildProjectName)' == 'Moonwell.Kit' Or '$(MSBuildProjectName)' == 'Moonwell.Spells' Or '$(MSBuildProjectName)' == 'Moonwell.Json' Or '$(MSBuildProjectName)' == 'Moonwell.Procgen' Or '$(MSBuildProjectName)' == 'Moonwell.AI' Or '$(MSBuildProjectName)' == 'Moonwell.AI.Combat' Or '$(MSBuildProjectName)' == 'Moonwell.Simulation'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'Moonwell' And '$(MSBuildProjectName)' != 'Moonwell.Natives' And '$(MSBuildProjectName)' != 'Moonwell.Objects' And '$(MSBuildProjectName)' != 'Moonwell.Damage' And '$(MSBuildProjectName)' != 'Moonwell.Maths' And '$(MSBuildProjectName)' != 'Moonwell.Interactions' And '$(MSBuildProjectName)' != 'Moonwell.Physics' And '$(MSBuildProjectName)' != 'Moonwell.Terrain' And '$(MSBuildProjectName)' != 'Moonwell.Pathing' And '$(MSBuildProjectName)' != 'Moonwell.Areas' And '$(MSBuildProjectName)' != 'Moonwell.Input' And '$(MSBuildProjectName)' != 'Moonwell.Frames' And '$(MSBuildProjectName)' != 'Moonwell.Kit' And '$(MSBuildProjectName)' != 'Moonwell.Spells' And '$(MSBuildProjectName)' != 'Moonwell.Json' And '$(MSBuildProjectName)' != 'Moonwell.Procgen' And '$(MSBuildProjectName)' != 'Moonwell.AI' And '$(MSBuildProjectName)' != 'Moonwell.AI.Combat' And '$(MSBuildProjectName)' != 'Moonwell.Simulation' And '$(MSBuildProjectName)' != 'Moonwell.Testing'">
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Every dotnet test run ends: a test that stops making progress fails the run (tests/Tests.runsettings). -->
  <PropertyGroup>
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)tests\Tests.runsettings</RunSettingsFilePath>
  </PropertyGroup>

</Project>
